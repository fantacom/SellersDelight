# Port des Webservers
PORT=3000
# Pflicht in Produktion: langer Zufallswert (z. B. `openssl rand -base64 48`)
SESSION_SECRET=
# production aktiviert sichere Cookies (HTTPS erforderlich)
NODE_ENV=production
# Öffentliche URL (für Einladungslinks in E-Mails)
BASE_URL=https://www.sellersdelight.de

# Erster Administrator (nur beim allerersten Start relevant)
ADMIN_EMAIL=
ADMIN_PASSWORD=

# Kontaktadresse für „Sind Sie dieser Anbieter?" auf Profilseiten (optional)
CONTACT_EMAIL=
# Benachrichtigung über neue Bewertungen/Einträge (optional)
ADMIN_NOTIFY_EMAIL=

# E-Mail-Versand (optional – ohne SMTP werden Einladungslinks im Backend angezeigt)
SMTP_HOST=
SMTP_PORT=587
SMTP_SECURE=false
SMTP_USER=
SMTP_PASS=
MAIL_FROM=Seller's Delight <no-reply@sellersdelight.de>

# Speicherort der SQLite-Datenbank (Standard: ./data/sellersdelight.db)
# DB_PATH=/var/lib/sellersdelight/sellersdelight.db
