<%- include('../partials/head') %>
<main>
  <div class="container">
    <div class="page-head">
      <div class="breadcrumb"><a href="/">Start</a> / <a href="/#kategorien">Kategorien</a> / <%= category.name %></div>
      <div style="display:flex;gap:16px;align-items:center">
        <span class="icon-tile lg"><%- include('../partials/icon', { name: category.icon }) %></span>
        <div><h1 style="margin:0"><%= category.name %></h1><p class="muted" style="margin:0"><%= category.description %></p></div>
      </div>
      <%- include('../partials/flash') %>
    </div>

    <div class="toolbar" style="margin-top:24px;justify-content:space-between">
      <span class="muted small"><%= providers.length %> <%= providers.length === 1 ? 'Anbieter' : 'Anbieter' %></span>
      <div class="tabs" style="margin:0;border:0">
        <% Object.entries(sortLabels).forEach(([k, label]) => { %>
          <a href="?sort=<%= k %>" class="<%= sort === k ? 'active' : '' %>"><%= label %></a>
        <% }) %>
      </div>
    </div>

    <% if (providers.length) { %>
      <div class="provider-list">
        <% providers.forEach((p, i) => { %><%- include('../partials/provider-row', { p, rank: i + 1 }) %><% }) %>
      </div>
      <p class="small muted" style="margin-top:14px">Die Reihenfolge nach „Beste Bewertung" berücksichtigt Durchschnitt und Anzahl der Bewertungen, damit einzelne Bewertungen nicht überproportional zählen.</p>
    <% } else { %>
      <div class="card empty">
        <span class="icon-tile lg"><%- include('../partials/icon', { name: category.icon }) %></span>
        <p>In dieser Kategorie gibt es noch keine Einträge.</p>
      </div>
    <% } %>

    <div class="cta-band" style="margin:28px 0 20px">
      <div><h3>Anbieter fehlt?</h3><p>Tragen Sie einen <%= category.name %>-Anbieter ein, den Sie empfehlen können.</p></div>
      <a class="btn" href="/anbieter-eintragen?kategorie=<%= category.slug %>">Anbieter eintragen</a>
    </div>
  </div>
</main>
<%- include('../partials/foot') %>
