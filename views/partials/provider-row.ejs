<a class="provider-row" href="/anbieter/<%= p.slug %>">
  <div class="rank <%= rank <= 3 && p.review_count ? 'top' : '' %>"><%= rank %></div>
  <div class="avatar"><%= p.name.replace(/[^A-Za-zÄÖÜäöü0-9 ]/g, '').split(/\s+/).filter(Boolean).slice(0, 2).map(w => w[0]).join('').toUpperCase() || '?' %></div>
  <div>
    <h3><%= p.name %></h3>
    <p><%= p.short_description %></p>
    <div class="provider-meta">
      <% if (p.city) { %><span><%= p.city %></span><% } %>
      <% if (p.founded_year) { %><span>Seit <%= p.founded_year %></span><% } %>
      <% if (typeof showCats !== 'undefined' && showCats) p.categories.forEach(c => { %><span class="tag"><%= c.name %></span><% }) %>
    </div>
  </div>
  <div class="rating-box">
    <div class="score"><%= formatRating(p.avg_rating) %></div>
    <%- include('stars', { value: p.avg_rating, size: '' }) %>
    <div class="count"><%= p.review_count %> <%= p.review_count === 1 ? 'Bewertung' : 'Bewertungen' %></div>
  </div>
</a>
