<%- include('head') %>
<% const nav = [
  ['/admin', 'home', 'Übersicht', null],
  ['/admin/bewertungen', 'message', 'Bewertungen', pending.reviews],
  ['/admin/anbieter', 'list', 'Anbieter', pending.providers],
  ['/admin/kategorien', 'tag', 'Kategorien', null],
  ['/admin/benutzer', 'users', 'Benutzer & Zugänge', null],
];
const isActive = (href) => href === '/admin' ? /^\/admin\/?$/.test(path) : (path === href || path.startsWith(href + '/'));
%>
<div class="admin-shell">
  <aside class="admin-side">
    <nav aria-label="Backend">
      <% nav.forEach(([href, icon, label, count]) => { %>
        <a href="<%= href %>" class="<%= isActive(href) ? 'active' : '' %>"><%- include('icon', { name: icon }) %><%= label %><% if (count) { %><span class="count"><%= count %></span><% } %></a>
      <% }) %>
      <div class="sep"></div>
      <a href="/konto/passwort"><%- include('icon', { name: 'key' }) %>Passwort ändern</a>
      <a href="/" target="_blank"><%- include('icon', { name: 'external' }) %>Website ansehen</a>
    </nav>
  </aside>
  <div class="admin-main">
    <%- include('flash') %>
