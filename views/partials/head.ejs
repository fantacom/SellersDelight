<!doctype html>
<html lang="de">
<head>
  <meta charset="utf-8">
  <meta name="viewport" content="width=device-width, initial-scale=1">
  <title><%= title ? title + " · " + siteName : siteName + " – Die besten Dienstleister für E-Commerce-Seller" %></title>
  <meta name="description" content="<%= typeof metaDescription !== 'undefined' ? metaDescription : 'Bewertete Dienstleister für Amazon- und E-Commerce-Seller: Fotostudios, Agenturen, Steuerberater, Fulfillment und mehr.' %>">
  <link rel="icon" href="/img/favicon.svg" type="image/svg+xml">
  <link rel="stylesheet" href="/css/style.css">
  <script src="/js/app.js" defer></script>
</head>
<body>
<header class="site-header">
  <div class="container">
    <a class="brand" href="/"><%- include('logo-mark') %><span>Seller's <span class="accent">Delight</span></span></a>
    <button class="nav-toggle" type="button" aria-label="Menü" aria-expanded="false"><span style="display:block;width:24px;height:24px"><%- include('icon', { name: 'menu' }) %></span></button>
    <nav class="main-nav" aria-label="Hauptnavigation">
      <a href="/#kategorien" class="<%= path === '/' ? 'active' : '' %>">Kategorien</a>
      <a href="/suche" class="<%= path === '/suche' ? 'active' : '' %>">Suche</a>
      <% if (user) { %>
        <a href="<%= user.role === 'admin' ? '/admin' : '/konto' %>"><%= user.role === 'admin' ? 'Backend' : 'Mein Konto' %></a>
        <form method="post" action="/logout"><input type="hidden" name="_csrf" value="<%= csrf %>"><button class="btn btn-ghost btn-sm" type="submit">Abmelden</button></form>
      <% } else { %>
        <a href="/login">Anmelden</a>
      <% } %>
      <a class="btn btn-sm" href="/anbieter-eintragen">Anbieter eintragen</a>
    </nav>
  </div>
</header>
