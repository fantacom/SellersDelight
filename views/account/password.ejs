<%- include('../partials/head') %>
<main>
  <div class="auth-wrap">
    <div class="card">
      <h1 style="font-size:1.4rem">Passwort ändern</h1>
      <% if (error) { %><div class="alert alert-error"><%= error %></div><% } %>
      <form method="post">
        <input type="hidden" name="_csrf" value="<%= csrf %>">
        <div class="field"><label for="cur">Aktuelles Passwort</label><input id="cur" type="password" name="current" required autocomplete="current-password"></div>
        <div class="field"><label for="pw">Neues Passwort <span class="hint">mind. 10 Zeichen</span></label><input id="pw" type="password" name="password" required minlength="10" autocomplete="new-password"></div>
        <div class="field"><label for="pw2">Neues Passwort wiederholen</label><input id="pw2" type="password" name="password_confirm" required autocomplete="new-password"></div>
        <div class="btn-row"><button class="btn" type="submit">Speichern</button><a class="btn btn-ghost" href="<%= user.role === 'admin' ? '/admin' : '/konto' %>">Abbrechen</a></div>
      </form>
    </div>
  </div>
</main>
<%- include('../partials/foot') %>
