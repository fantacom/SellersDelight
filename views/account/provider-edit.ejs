<%- include('../partials/head') %>
<main>
  <div class="container narrow" style="padding:36px 20px 40px">
    <div class="breadcrumb"><a href="/konto">Mein Konto</a> / <%= provider.name %></div>
    <h1><%= provider.name %> bearbeiten</h1>
    <p class="muted">Änderungen werden vor der Veröffentlichung von uns geprüft.<% if (provider.status === 'published') { %> <a href="/anbieter/<%= provider.slug %>" target="_blank">Öffentliches Profil ansehen ↗</a><% } %></p>
    <%- include('../partials/flash') %>
    <%- include('../partials/errors', { errors }) %>
    <% if (pending) { %>
      <div class="alert alert-info">Ihre Änderungen vom <%= formatDate(pending.created_at) %> warten auf Freigabe. Das Formular zeigt Ihren eingereichten Stand; erneutes Speichern ersetzt den Vorschlag.</div>
    <% } else if (lastDecision && lastDecision.status === 'rejected') { %>
      <div class="alert alert-error">Ihre letzten Änderungen (<%= formatDate(lastDecision.reviewed_at) %>) wurden nicht übernommen.<% if (lastDecision.note) { %> Anmerkung: <%= lastDecision.note %><% } %></div>
    <% } %>
    <form method="post">
      <%- include('../partials/provider-form', { provider, sections, mode: 'editor' }) %>
      <div class="sticky-actions"><div class="btn-row"><button class="btn" type="submit">Zur Prüfung einreichen</button><a class="btn btn-ghost" href="/konto">Abbrechen</a></div></div>
    </form>
  </div>
</main>
<%- include('../partials/foot') %>
