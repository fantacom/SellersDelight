<%- include('../partials/admin-start') %>
<% const isNew = !provider.id; %>
<div class="breadcrumb"><a href="/admin/anbieter">Anbieter</a> / <%= isNew ? 'Neu' : provider.name %></div>
<div class="section-head">
  <h1 style="margin:0"><%= isNew ? 'Neuer Anbieter' : provider.name %></h1>
  <% if (!isNew) { %><a class="btn btn-secondary btn-sm" href="/anbieter/<%= provider.slug %>" target="_blank">Profil ansehen ↗</a><% } %>
</div>
<% if (provider.submitted_by_email) { %>
  <div class="alert alert-info">Eingereicht von <strong><%= provider.submitted_by_name %></strong> (<a href="mailto:<%= provider.submitted_by_email %>"><%= provider.submitted_by_email %></a>) am <%= formatDate(provider.created_at) %>.</div>
<% } %>
<%- include('../partials/errors', { errors }) %>

<form method="post" action="<%= isNew ? '/admin/anbieter/neu' : '/admin/anbieter/' + provider.id %>">
  <div class="card">
    <div class="grid-2">
      <div class="field" style="margin:0">
        <label for="status">Status</label>
        <select id="status" name="status">
          <option value="published" <%= provider.status === 'published' ? 'selected' : '' %>>Veröffentlicht</option>
          <option value="pending" <%= provider.status === 'pending' ? 'selected' : '' %>>Zur Prüfung (nicht öffentlich)</option>
          <option value="rejected" <%= provider.status === 'rejected' ? 'selected' : '' %>>Abgelehnt (nicht öffentlich)</option>
        </select>
      </div>
      <% if (!isNew) { %>
      <div class="field" style="margin:0">
        <label for="slug">URL-Kürzel <span class="hint">/anbieter/…</span></label>
        <input id="slug" type="text" name="slug" value="<%= provider.slug %>" maxlength="80">
      </div>
      <% } %>
    </div>
  </div>
  <%- include('../partials/provider-form', { provider, sections: { master: true, description: true, categories: true, products: true }, mode: 'admin' }) %>
  <div class="sticky-actions"><div class="btn-row"><button class="btn" type="submit">Speichern</button><a class="btn btn-ghost" href="/admin/anbieter">Zurück</a></div></div>
</form>

<% if (!isNew) { %>
<div class="card" id="zugaenge" style="margin-top:24px">
  <h2>Zugänge für Dritte</h2>
  <p class="muted small">Geben Sie z. B. dem Anbieter selbst Zugriff, damit er sein Profil pflegt. Sie legen fest, welche Bereiche bearbeitet werden dürfen. Kategorien und Status bleiben immer bei Ihnen.</p>
  <% if (editors.length) { %>
  <div class="table-wrap" style="margin-bottom:18px">
    <table>
      <thead><tr><th>Person</th><th>Darf bearbeiten</th><th></th></tr></thead>
      <tbody>
      <% editors.forEach(e => { %>
        <tr>
          <td><a href="/admin/benutzer/<%= e.user_id %>"><strong><%= e.name %></strong></a><div class="sub"><%= e.email %></div></td>
          <td>
            <form method="post" action="/admin/benutzer/<%= e.user_id %>/zuweisen" data-autosubmit class="perm-checks">
              <input type="hidden" name="_csrf" value="<%= csrf %>"><input type="hidden" name="provider_id" value="<%= provider.id %>">
              <label class="check"><input type="checkbox" name="can_edit_master" value="1" <%= e.can_edit_master ? 'checked' : '' %>> Firmendaten</label>
              <label class="check"><input type="checkbox" name="can_edit_description" value="1" <%= e.can_edit_description ? 'checked' : '' %>> Beschreibung</label>
              <label class="check"><input type="checkbox" name="can_edit_products" value="1" <%= e.can_edit_products ? 'checked' : '' %>> Produkte</label>
            </form>
          </td>
          <td style="text-align:right"><form class="inline-form" method="post" action="/admin/benutzer/<%= e.user_id %>/zuweisung/<%= provider.id %>/entfernen" data-confirm="Zugriff entfernen?"><input type="hidden" name="_csrf" value="<%= csrf %>"><button class="btn btn-danger btn-sm">Entfernen</button></form></td>
        </tr>
      <% }) %>
      </tbody>
    </table>
  </div>
  <% } %>
  <form method="post" action="/admin/anbieter/<%= provider.id %>/zugang">
    <input type="hidden" name="_csrf" value="<%= csrf %>">
    <div class="grid-2">
      <div class="field"><label for="z-mail">E-Mail</label><input id="z-mail" type="email" name="email" value="<%= provider.email || '' %>" required></div>
      <div class="field"><label for="z-name">Name <span class="hint">Ansprechpartner</span></label><input id="z-name" type="text" name="name" placeholder="<%= provider.name %>"></div>
    </div>
    <div class="perm-checks field">
      <label class="check"><input type="checkbox" name="can_edit_master" value="1" checked> Firmendaten</label>
      <label class="check"><input type="checkbox" name="can_edit_description" value="1" checked> Beschreibung</label>
      <label class="check"><input type="checkbox" name="can_edit_products" value="1" checked> Produkte</label>
    </div>
    <div class="field"><label class="check"><input type="checkbox" name="send_invite" value="1" checked> Einladung senden („Für Sie wurde ein Zugang angelegt …")</label></div>
    <button class="btn btn-secondary" type="submit">Zugang anlegen / zuweisen</button>
  </form>
</div>

<div class="card" style="margin-top:24px">
  <h3>Anbieter löschen</h3>
  <p class="muted small">Löscht den Anbieter inklusive Produkten, Bewertungen und Zuweisungen endgültig.</p>
  <form method="post" action="/admin/anbieter/<%= provider.id %>/loeschen" data-confirm="„<%= provider.name %>“ mit allen Bewertungen endgültig löschen?"><input type="hidden" name="_csrf" value="<%= csrf %>"><button class="btn btn-danger">Endgültig löschen</button></form>
</div>
<% } %>
<%- include('../partials/admin-end') %>
