<%- include('../partials/admin-start') %>
<h1>Bewertungen</h1>
<div class="tabs">
  <a href="?status=pending" class="<%= status === 'pending' ? 'active' : '' %>">Zur Prüfung (<%= counts.pending %>)</a>
  <a href="?status=approved" class="<%= status === 'approved' ? 'active' : '' %>">Freigegeben (<%= counts.approved %>)</a>
  <a href="?status=rejected" class="<%= status === 'rejected' ? 'active' : '' %>">Abgelehnt (<%= counts.rejected %>)</a>
  <a href="?status=all" class="<%= status === 'all' ? 'active' : '' %>">Alle</a>
</div>
<% if (!reviews.length) { %>
  <div class="card empty"><p>Keine Bewertungen in dieser Ansicht.</p></div>
<% } %>
<% reviews.forEach(r => { %>
<div class="mod-card">
  <div class="head">
    <div>
      <%- include('../partials/stars', { value: r.rating, size: '' }) %>
      <strong style="margin-left:6px"><%= r.rating %>/5</strong> für
      <a href="/anbieter/<%= r.provider_slug %>" target="_blank"><strong><%= r.provider_name %></strong></a>
      <% if (r.provider_status !== 'published') { %><span class="badge badge-pending">Anbieter nicht öffentlich</span><% } %>
    </div>
    <span class="badge badge-<%= r.status %>"><%= { pending: 'Zur Prüfung', approved: 'Freigegeben', rejected: 'Abgelehnt' }[r.status] %></span>
  </div>
  <% if (r.title) { %><h4 style="margin:4px 0"><%= r.title %></h4><% } %>
  <p><%= r.comment %></p>
  <div class="small muted" style="margin-bottom:12px"><%= r.author_name %> · <a href="mailto:<%= r.author_email %>"><%= r.author_email %></a> · <%= formatDate(r.created_at) %></div>
  <div class="btn-row">
    <% if (r.status !== 'approved') { %>
      <form class="inline-form" method="post" action="/admin/bewertungen/<%= r.id %>/freigeben"><input type="hidden" name="_csrf" value="<%= csrf %>"><button class="btn btn-success btn-sm">Freigeben</button></form>
    <% } %>
    <% if (r.status !== 'rejected') { %>
      <form class="inline-form" method="post" action="/admin/bewertungen/<%= r.id %>/ablehnen"><input type="hidden" name="_csrf" value="<%= csrf %>"><button class="btn btn-secondary btn-sm">Ablehnen</button></form>
    <% } %>
    <form class="inline-form" method="post" action="/admin/bewertungen/<%= r.id %>/loeschen" data-confirm="Bewertung endgültig löschen?"><input type="hidden" name="_csrf" value="<%= csrf %>"><button class="btn btn-danger btn-sm">Löschen</button></form>
  </div>
</div>
<% }) %>
<%- include('../partials/admin-end') %>
